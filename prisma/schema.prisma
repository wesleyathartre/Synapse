// CRM para corretores de seguros — schema Prisma (SQLite)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ORGANIZAÇÃO (CORRETORA / TENANT) ====================
// Cada corretora é um "tenant" isolado. Todos os dados carregam o orgId dela.
model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique // identificador amigável (ex.: pupo-corretora)
  plan        String    @default("PROFISSIONAL") // ESSENCIAL | PROFISSIONAL | EMPRESARIAL
  status      String    @default("TRIAL")        // TRIAL | ACTIVE | SUSPENDED
  seatLimit   Int       @default(5)              // limite de usuários do plano
  trialEndsAt DateTime?                           // fim do período de teste
  internalNotes String?                            // anotações internas do OWNER (não visível à corretora)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users User[]

  @@index([status])
}

// ==================== PLANOS COMERCIAIS ====================
// Preço e limite de usuários editáveis pelo OWNER (sobrescreve os padrões do código).
model Plan {
  code         String   @id // ESSENCIAL | PROFISSIONAL | EMPRESARIAL
  label        String
  seatLimit    Int
  priceMonthly Int // em reais
  updatedAt    DateTime @updatedAt
}

// ==================== USUÁRIOS / CORRETORES ====================
model User {
  id        String   @id @default(cuid())
  orgId     String   // corretora à qual o usuário pertence
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("CORRETOR") // OWNER | ADMIN | CORRETOR
  avatarUrl String?
  active    Boolean  @default(true)

  // Permissões de acesso por tela (só para CORRETOR). Vazio = todas as telas liberadas.
  permissions String[] @default([])

  // LGPD — registro de consentimento
  acceptedTermsAt  DateTime? // aceite dos Termos + Política de Privacidade
  termsVersion     String?   // versão do documento aceito
  marketingConsent Boolean   @default(false) // opt-in de comunicações
  lastLoginAt      DateTime?

  // Notificações de boletos a vencer
  notifyBoletos    Boolean   @default(true)  // ativa/desativa avisos de boletos
  notifyDayOfWeek  Int       @default(1)     // 0=Dom 1=Seg 2=Ter 3=Qua 4=Qui 5=Sex 6=Sáb
  notifyEmail      String?                   // email alternativo para os avisos (null = usa email do usuário)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  leads            Lead[]
  clients          Client[]
  deals            Deal[]
  policies         Policy[]
  activities       Activity[]
  consentLogs      ConsentLog[]
  auditLogs        AuditLog[]
  boletos          Boleto[]
  sdrConversations SdrConversation[]
  claims           Claim[]
  policyAttachments PolicyAttachment[]

  @@index([orgId])
}

// ==================== LGPD — TRILHA DE CONSENTIMENTO ====================
// Guarda a prova de cada consentimento (com data, versão, IP e user agent).
model ConsentLog {
  id        String   @id @default(cuid())
  orgId     String?  // corretora (opcional em logs)
  userId    String
  type      String // TERMS | PRIVACY | MARKETING
  granted   Boolean
  version   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([orgId])
}

// ==================== SEGURANÇA — TRILHA DE AUDITORIA ====================
// Eventos sensíveis: login, cadastro, exportação e exclusão de dados, etc.
model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?  // corretora (opcional em logs)
  userId    String?
  email     String?
  action    String // REGISTER | LOGIN_SUCCESS | LOGIN_FAIL | PASSWORD_CHANGE | DATA_EXPORT | ACCOUNT_DELETE
  ip        String?
  userAgent String?
  meta      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([orgId])
}

// ==================== LEADS (topo do funil) ====================
model Lead {
  id        String   @id @default(cuid())
  orgId     String   // corretora (tenant)
  name      String
  email     String?
  phone     String
  source    String   @default("SITE")   // SITE | INDICACAO | FACEBOOK | INSTAGRAM | GOOGLE | LIGACAO | EVENTO | OUTRO
  interest  String   @default("AUTO")   // produto de interesse (ver constants)
  status    String   @default("NOVO")   // NOVO | EM_CONTATO | QUALIFICADO | CONVERTIDO | PERDIDO
  temp      String   @default("MORNO")  // FRIO | MORNO | QUENTE
  notes     String?
  ownerId   String

  // ---- Campos SDR (Fase 2 — preenchidos pelo agente de pré-atendimento) ----
  sdrStatus          String?   // NOVO | EM_TRIAGEM | QUALIFICADO | TRANSFERIDO | DESCARTADO
  sdrScore           Int?      // 0-100
  sdrClassification  String?   // QUENTE | MORNO | FRIO | NAO_QUALIFICADO
  sdrChannel         String?   // WHATSAPP | LANDING_PAGE | INSTAGRAM | INDICACAO
  sdrIntention       String?   // ORCAMENTO | CONHECER | AGENDAR | JA_CLIENTE | HUMANO
  sdrNeed            String?   // descrição livre da necessidade relatada
  sdrDeadline        String?   // IMEDIATO | ATE_30_DIAS | PESQUISANDO | SEM_PREVISAO
  sdrCity            String?
  sdrIsDecisionMaker String?   // SIM | NAO | NAO_INFORMADO
  sdrSummary         String?   // resumo gerado pelo agente
  sdrNextAction      String?   // ATENDIMENTO_HUMANO | ORCAMENTO | AGENDAR | NUTRIR
  sdrAssignedTo      String?   // userId do responsável pelo atendimento humano
  sdrDiscardReason   String?
  sdrStartedAt       DateTime?
  sdrTransferredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner            User              @relation(fields: [ownerId], references: [id])
  sdrConversations SdrConversation[]

  @@index([status])
  @@index([ownerId])
  @@index([sdrStatus])
  @@index([sdrScore])
  @@index([orgId])
}

// ==================== CLIENTES / SEGURADOS ====================
model Client {
  id        String   @id @default(cuid())
  orgId     String   // corretora (tenant)
  name      String
  email     String?
  phone     String
  cpfCnpj   String?
  birthDate DateTime?
  address   String?
  city      String?
  state     String?
  notes     String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User     @relation(fields: [ownerId], references: [id])
  deals    Deal[]
  policies Policy[]
  boletos  Boleto[]
  claims   Claim[]

  @@index([ownerId])
  @@index([orgId])
}

// ==================== FUNIL DE VENDAS (Oportunidades/Negócios) ====================
model Deal {
  id                String    @id @default(cuid())
  orgId             String    // corretora (tenant)
  title             String
  product           String    @default("AUTO") // AUTO | VIDA | RESIDENCIAL | SAUDE | EMPRESARIAL | VIAGEM | CONSORCIO
  stage             String    @default("NOVO") // NOVO | CONTATO | PROPOSTA | NEGOCIACAO | GANHO
  status            String    @default("OPEN") // OPEN | WON | LOST
  value             Float     @default(0)      // valor segurado / ticket
  premium           Float     @default(0)      // prêmio (o que o cliente paga)
  commission        Float     @default(0)      // comissão estimada do corretor
  probability       Int       @default(50)     // 0-100
  expectedCloseDate DateTime?
  lostReason        String?
  clientId          String?
  clientName        String
  clientPhone       String?
  ownerId           String
  order             Int       @default(0)      // ordenação dentro da coluna do kanban
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client     Client?    @relation(fields: [clientId], references: [id])
  owner      User       @relation(fields: [ownerId], references: [id])
  activities Activity[]
  policies   Policy[]
  boletos    Boleto[]

  @@index([stage])
  @@index([status])
  @@index([ownerId])
  @@index([orgId])
}

// ==================== APÓLICES ====================
model Policy {
  id              String   @id @default(cuid())
  orgId           String   // corretora (tenant)
  number          String
  product         String   @default("AUTO")
  insurer         String
  clientId        String
  clientName      String
  premium         Float    @default(0)
  commission      Float    @default(0)
  startDate       DateTime @default(now())
  endDate         DateTime // data de renovação
  status          String   @default("ATIVA") // ATIVA | A_VENCER | VENCIDA | CANCELADA | RENOVADA
  dealId          String?
  ownerId         String
  notes           String?
  // Parcelamento — para gerar boletos automáticos
  paymentType     String   @default("UNICO") // UNICO | MENSAL | TRIMESTRAL | SEMESTRAL | ANUAL
  installments    Int      @default(1)       // número de parcelas
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client      Client             @relation(fields: [clientId], references: [id])
  owner       User               @relation(fields: [ownerId], references: [id])
  deal        Deal?              @relation(fields: [dealId], references: [id])
  boletos     Boleto[]
  claims      Claim[]
  attachments PolicyAttachment[]

  @@unique([orgId, number])
  @@index([status])
  @@index([endDate])
  @@index([ownerId])
  @@index([orgId])
}

// ==================== ANEXOS DE APÓLICE (PDF) ====================
// Guarda o arquivo (PDF) da apólice/endosso vinculado a uma apólice.
model PolicyAttachment {
  id        String   @id @default(cuid())
  orgId     String   // corretora (tenant)
  policyId  String
  ownerId   String
  filename  String
  mimeType  String   @default("application/pdf")
  size      Int      @default(0)
  data      Bytes
  createdAt DateTime @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerId], references: [id])

  @@index([policyId])
  @@index([ownerId])
  @@index([orgId])
}

// ==================== SINISTROS ====================
// Acompanhamento de avarias/acionamentos do cliente junto à seguradora.
model Claim {
  id           String    @id @default(cuid())
  orgId        String    // corretora (tenant)
  number       String?   // número do sinistro na seguradora
  clientId     String
  clientName   String    // desnormalizado para listagens
  policyId     String?
  policyNumber String?
  insurer      String?
  product      String    @default("AUTO")
  type         String    @default("OUTRO")  // COLISAO | ROUBO | FURTO | INCENDIO | DANOS | TERCEIROS | ALAGAMENTO | SAUDE | OUTRO
  status       String    @default("ABERTO") // ABERTO | EM_ANALISE | APROVADO | NEGADO | PAGO | ENCERRADO
  description  String?
  incidentDate DateTime  @default(now())     // data do ocorrido
  reportedDate DateTime  @default(now())     // data da comunicação
  amount       Float     @default(0)         // valor estimado / indenização
  notes        String?
  ownerId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client Client  @relation(fields: [clientId], references: [id])
  policy Policy? @relation(fields: [policyId], references: [id])
  owner  User    @relation(fields: [ownerId], references: [id])

  @@index([status])
  @@index([ownerId])
  @@index([clientId])
  @@index([policyId])
  @@index([orgId])
}

// ==================== ATIVIDADES / TAREFAS / AGENDA ====================
model Activity {
  id          String   @id @default(cuid())
  orgId       String   // corretora (tenant)
  type        String   @default("TAREFA") // LIGACAO | WHATSAPP | EMAIL | REUNIAO | TAREFA
  title       String
  description String?
  dueDate     DateTime
  done        Boolean  @default(false)
  doneAt      DateTime?
  dealId      String?
  clientId    String?
  leadId      String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User  @relation(fields: [ownerId], references: [id])
  deal  Deal? @relation(fields: [dealId], references: [id])

  @@index([done])
  @@index([dueDate])
  @@index([ownerId])
  @@index([orgId])
}

// ==================== CATÁLOGO DE PRODUTOS ====================
// Fonte de verdade dos produtos ofertados. O admin pode ativar/desativar
// e criar novos produtos sem alterar o código.
model Product {
  id        String   @id @default(cuid())
  orgId     String   // corretora (tenant)
  code      String   // código usado nas oportunidades/apólices (ex.: AUTO)
  label     String
  color     String   @default("#2451eb")
  emoji     String   @default("🏷️")
  category  String   @default("DIVERSOS")
  active    Boolean  @default(true)
  custom    Boolean  @default(false) // criado pelo usuário (pode ser excluído)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, code])
  @@index([orgId])
  @@index([category])
  @@index([active])
}

// ==================== BOLETOS / PARCELAS ====================
// Parcelas vinculadas a apólices, deals ou lançadas manualmente.
model Boleto {
  id          String    @id @default(cuid())
  orgId       String    // corretora (tenant)
  clientId    String
  clientName  String    // desnormalizado para facilitar listagens
  policyId    String?
  dealId      String?
  ownerId     String
  description String    // ex: "Parcela 3/12 — Consórcio Auto"
  amount      Float
  dueDate     DateTime  // data de vencimento
  status      String    @default("PENDENTE") // PENDENTE | PAGO | VENCIDO | CANCELADO
  paidAt      DateTime?
  barcode     String?   // linha digitável (preenchida manualmente)
  notes       String?
  // origem: MANUAL = lançado pelo corretor; AUTO = gerado pela apólice
  origin      String    @default("MANUAL")  // MANUAL | AUTO
  installmentNumber Int? // número da parcela (ex: 3 de 12)
  installmentTotal  Int? // total de parcelas
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client Client  @relation(fields: [clientId], references: [id])
  policy Policy? @relation(fields: [policyId], references: [id])
  deal   Deal?   @relation(fields: [dealId], references: [id])
  owner  User    @relation(fields: [ownerId], references: [id])

  @@index([dueDate])
  @@index([status])
  @@index([ownerId])
  @@index([clientId])
  @@index([policyId])
  @@index([orgId])
}

// ==================== SDR — CONVERSAS DE PRÉ-ATENDIMENTO ====================
// Histórico de cada atendimento iniciado pelo Synapse SDR (Fase 2).
// Estrutura preparada; integração WhatsApp ativada na Fase 2.
model SdrConversation {
  id            String    @id @default(cuid())
  orgId         String    // corretora (tenant)
  leadId        String
  ownerId       String
  channel       String    @default("WHATSAPP") // WHATSAPP | INSTAGRAM | WEB
  phone         String    // número de contato (identificador da conversa)
  state         String    @default("GREETING") // estado atual da máquina de estados
  messages      Json      @default("[]")        // array de { role, content, timestamp }
  score         Int       @default(0)
  classification String?  // QUENTE | MORNO | FRIO | NAO_QUALIFICADO
  active        Boolean   @default(true)        // false = conversa encerrada / transferida
  transferredAt DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lead  Lead @relation(fields: [leadId], references: [id])
  owner User @relation(fields: [ownerId], references: [id])

  @@index([phone])
  @@index([active])
  @@index([leadId])
  @@index([ownerId])
  @@index([orgId])
}

// ==================== SDR — CONFIGURAÇÃO DO FLUXO ====================
// Configurações globais do SDR: mensagens, pesos do score, etc.
// Uma linha por tenant (ownerId). Fase 2.
model SdrConfig {
  id                String   @id @default(cuid())
  orgId             String   // corretora (tenant)
  ownerId           String   @unique
  active            Boolean  @default(false)  // SDR ativado?
  welcomeMessage    String?  // mensagem de boas-vindas customizada
  scoreWeights      Json     @default("{}")   // pesos configuráveis do score
  allowedRegions    String?  // regiões atendidas (texto livre)
  handoffThreshold  Int      @default(60)     // score mínimo para handoff automático
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerId])
  @@index([orgId])
}

// ==================== LANDING PAGE — CONFIGURAÇÃO EDITÁVEL ====================
// Conteúdo da Landing Page controlado pelo cliente no CRM (sem mexer em código).
// Singleton: sempre id = "default" (multi-tenant fica para uma fase futura).
model LandingConfig {
  id              String   @id @default("default")
  campaignEnabled Boolean  @default(false)          // liga/desliga a faixa de campanha
  campaignText    String   @default("")             // texto da campanha
  campaignLink    String   @default("#simulador")   // para onde a campanha leva
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== SEGURADORAS (catálogo de fornecedores) ====================
// Catálogo das seguradoras com quem o corretor trabalha (Porto, Suhai, Ademicon...).
model Insurer {
  id         String   @id @default(cuid())
  orgId      String   // corretora (tenant)
  name       String
  color      String   @default("#2451eb")   // cor de identificação
  website    String?                          // portal do corretor
  phone      String?                          // central de atendimento
  commission Float    @default(0)             // % de comissão padrão
  notes      String?                          // observações livres
  active     Boolean  @default(true)
  custom     Boolean  @default(false)         // criada pelo usuário (pode excluir)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}


