# ===================== BANCO DE DADOS (Supabase / Postgres) =====================
# DATABASE_URL: conexão via POOLER (porta 6543) — usada pela app em runtime (Vercel).
# DIRECT_URL:   conexão DIRETA (porta 5432) — usada por migrations / prisma db push.
# Pegue as duas em: Supabase > Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo do JWT (gere um forte, ex.: openssl rand -base64 48)
JWT_SECRET="troque-por-um-segredo-forte"

# Origem permitida (CORS) para o formulário da Landing Page criar leads.
# Em produção, use o domínio da LP, ex.: https://pupocorretora.com.br
LANDING_ORIGIN="*"

# ===================== SYNAPSE SDR (Fase 2 — WhatsApp Business) =====================
# Obtenha no Meta Developer Console > WhatsApp > Configuração
# Deixe em branco para o SDR ficar em modo "apenas log" (modo dev)
WHATSAPP_VERIFY_TOKEN="synapse-sdr-token"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
